# 换行符与二进制判定。
#
# 为什么必须显式声明 .sh：本项目在 Windows 上开发，默认 core.autocrlf=true 会把
# `deploy/entrypoint.sh` 存成 CRLF。该文件被 COPY 进 Linux 容器后，
# 内核读 shebang 会拿到 `#!/bin/sh\r`，报 `/bin/sh^M: not found` —— 镜像起来即崩。
# 强制 LF 是唯一可靠的解法。

* text=auto eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.css           text eol=lf
*.md            text eol=lf

# Windows 脚本保持 CRLF：部分旧版 PowerShell 对 LF-only 的 .ps1 解析不稳。
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# 二进制：禁止任何换行符转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           text eol=lf
*.woff          binary
*.woff2         binary
*.ttf           binary
*.whl           binary
*.gz            binary
*.zip           binary

# 语言统计/差异展示
package-lock.json  linguist-generated=true -diff
