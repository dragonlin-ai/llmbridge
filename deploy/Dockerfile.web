# 说明：刻意不写 `# syntax=docker/dockerfile:1` —— 那行会让 buildx 去拉
# docker/dockerfile 前端镜像，在国内网络下可能连 auth.docker.io 都到不了，
# 构建死在第一步。本文件只用普通语法，守护进程内置 BuildKit 完全够用。
#
# LLM 路由中转系统 · 控制台前端镜像
#
# 构建（**上下文必须是仓库根目录**）：
#   docker build -f deploy/Dockerfile.web -t llmbridge-web:1.0.0 .
#
# 为什么单独做一个镜像（而不是像部署形态那样把 dist 挂进 nginx）：
#   原形态要求目标机持有源码目录、且改前端必须重新 build dist —— 交付时
#   「镜像 + compose」两个文件起不来，因为 nginx 找不到要托管的东西。
#   把 dist 与 nginx.conf 一起打进镜像后，容器库里的两个镜像即构成完整系统，
#   目标机**不需要任何源码**。代价是改前端要重新出镜像（这正是镜像交付的代价）。
#
# 注意 dist 与 nginx.conf 都是**打进镜像**的：想改反代规则要重建镜像，
#   或临时用 `-v ./nginx.conf:/etc/nginx/conf.d/default.conf:ro` 覆盖。

# ---------- 阶段一：构建静态产物 ----------
FROM node:22-alpine AS build

WORKDIR /src

# 依赖清单先拷，源码后拷：改业务代码不会让 npm ci 这层缓存失效。
# 用 npm ci 而非 npm install —— 严格按 package-lock.json 装，构建可复现。
COPY admin-web/package.json admin-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY admin-web/ ./

# package.json 的 build 脚本是 `vue-tsc -b && vite build`：
# 类型错误会让构建失败（这是有意的，别为了「先跑起来」把它改成只跑 vite）。
RUN npm run build

# ---------- 阶段二：静态托管 ----------
FROM nginx:1.27-alpine

# 反代规则里最不能少的是 `proxy_buffering off`（SSE 流式必需），
# 该文件已按本项目历史故障逐条注明，直接沿用仓库内那一份，避免两份配置漂移。
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

# busybox wget 探活，省掉在镜像里装 curl。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1/"]

CMD ["nginx", "-g", "daemon off;"]
