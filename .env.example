# ============================================================
# LLM 路由中转系统 · 环境变量模板
# 复制为 .env 后按需修改。标【生产必改】的项严禁使用默认值。
# ============================================================

# ---- 数据库 ----
# 主用 PostgreSQL（异步驱动 psycopg3）。前缀写成 postgresql:// 或 postgres:// 均可，
# app/db/session.py 的 _to_async_url() 会自动补成 postgresql+psycopg://。
# 密码含特殊字符时需 URL 编码（@ : / ? # 等）。
#
# ⚠️ 不要写成 postgresql+asyncpg://：asyncpg 不在依赖里（Windows 上需 C 扩展编译），
#    写了会通过 URL 校验、然后在真正建连时才炸。
DATABASE_URL=postgresql+psycopg://llmbridge:change-me@127.0.0.1:5432/llmbridge

# Docker Compose 用（deploy/docker-compose.yml 里以 ${POSTGRES_PASSWORD} 注入 db 与 api）。
# 本机直连时代码不读这一项，双写只是为了让同一份 .env 在两种形态下都能用。
POSTGRES_PASSWORD=change-me
# Compose 映射到宿主机的控制台端口（默认 80）
HTTP_PORT=80

# 【仅离线演示兜底】不配 DATABASE_URL 时回退 SQLite；生产禁用。
# DATABASE_URL=sqlite:///./llmbridge.db

# ---- Redis（可选，缺省不启用缓存/限流，服务自动降级）----
REDIS_URL=

# ---- 安全【生产必改】----
# SSRF 白名单：是否允许厂商 base_url 用 http:// 及 localhost/私网地址。
# 开发机（需连本地/内网网关）置 true；生产【必须】false（安全方案 §7）。
ALLOW_LOCAL_BASE_URL=false
# JWT 签名密钥: python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_SECONDS=86400
# 厂商 API Key 加密主密钥（AES-256-GCM）: openssl rand -base64 32
# 【高危】丢失将导致所有已存厂商密钥无法解密；严禁提交 git
ENCRYPTION_MASTER_KEY=dev-only-change-me-32bytes-min!!

# ---- 判定器 ----
# mock = 内置无依赖判定（默认，离线可用）；jev = TypeSafe AI 官方 API（出境见安全方案§3）
# 实测（jev-1.13.0）：本机直连可达，单次 0.4~1.2s，DECIDER_TIMEOUT_MS=3000 够用；
# 若 judge_provider=jev 但 JEV_API_KEY 为空，会静默退回 mock（看板「判定器」会提示不一致）。
JUDGE_PROVIDER=mock
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# 判定器独立超时（毫秒）
DECIDER_TIMEOUT_MS=3000
# L2 置信度阈值 T2：低于此值走 L3 兜底
ROUTE_CONFIDENCE_THRESHOLD_T2=0.5

# ---- 路由 ----
# 全部候选失败时的最终默认模型 id
DEFAULT_MODEL_ID=1
# 上游调用超时（毫秒）
REQUEST_TIMEOUT_MS=30000
# 路由判定结果缓存 TTL（秒）
ROUTE_CACHE_TTL=3600

# ---- 日志 ----
# request_log 异步批量写：批大小 / 刷盘间隔秒
LOG_BATCH_SIZE=50
LOG_FLUSH_SECONDS=1.0

# ---- 工具调用（WebFetch）----
# 【默认关】网关的职责是转发，不是替调用方编排。
# 关 = 纯透传：`tools` 原样转发给下游，上游返回什么就回什么（含原生 tool_calls），
#      工具交给调用方（前端 / Agent 客户端）自己执行 —— 标准 OpenAI 语义。
# 开 = 网关认出白名单工具后自己执行并续写多轮；仅适用于调用方完全没有工具循环的场景。
# 打开后网关会吞掉中间轮并改写正文，「模型只说了一句话」与「工具没执行」将难以区分。
ENABLE_TOOL_EXECUTION=false
# 抓回正文的字符上限（仅 ENABLE_TOOL_EXECUTION=true 时生效）。
# 实测某新闻页原始 HTML 达 120KB，不截断会把单次请求 prompt 从 500 撑到 18800 token。
TOOL_RESULT_MAX_CHARS=8000
